# ============================================================================
# Social Hub / Content OS — variables de entorno
# Copiá este archivo a .env.local y completá. NUNCA se commitea el .env.local.
# En el servidor viven en /opt/social-hub (el deploy los excluye del rsync).
# ============================================================================

# --- Supabase OlivosSpeed ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://jhftgcjiymjcamjikuwe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave de servicio: se saltea RLS. Solo servidor y worker.
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa para migraciones y scripts (pooler de São Paulo, puerto 5432).
SUPABASE_DB_URL=postgresql://postgres.jhftgcjiymjcamjikuwe:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# --- Meta (Fase 1) ----------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Token del System User (no vence). De acá salen los page tokens.
META_SYSTEM_USER_TOKEN=
# Un page token por marca. En la base solo se guarda el NOMBRE de la variable.
META_PAGE_TOKEN_SENSACIONES=
META_PAGE_TOKEN_BIJUTSUKAN=
META_PAGE_TOKEN_FASUTOFUDO=

# --- Meta webhooks (Fase 2A — construida pero apagada hasta el trámite) ------
META_WEBHOOK_VERIFY_TOKEN=

# --- Integración con Turnos (Fase 1) ----------------------------------------
TURNOS_BASE_URL=https://turnos.kitchcocenter.com
CONTENT_OS_SECRET=

# --- Google Drive (Fase 1) --------------------------------------------------
# Ruta al JSON de la cuenta de servicio (montado de solo lectura en el contenedor).
GOOGLE_SERVICE_ACCOUNT_PATH=
GOOGLE_DRIVE_ROOT_ID=

# --- IA (Fase 1) ------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Argos (reporte de errores) ---------------------------------------------
ARGOS_CENTRAL_URL=https://argos.kitchcocenter.com
ARGOS_CENTRAL_TOKEN=
